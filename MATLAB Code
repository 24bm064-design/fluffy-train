%% =========================================================
% MATLAB Predictive Modeling of Hospital Resource Allocation
% Numeric matrix: hospital_resource
% Columns assumed:
% 1 = Nurses
% 2 = ICU Beds
% 3 = Flu Cases
% 4 = Surgeries
% ==========================================================

clc;
close all;
clearvars -except hospital_resource;

%% 1. Display Dataset Size
[nSamples, nFeatures] = size(hospital_resource);
fprintf('Dataset contains %d samples and %d features\n', nSamples, nFeatures);

%% 2. Data Cleaning
hospital_resource = hospital_resource(~any(isnan(hospital_resource),2), :);

%% 3. Extract Individual Variables
nurses    = hospital_resource(:,1);
icuBeds   = hospital_resource(:,2);
fluCases  = hospital_resource(:,3);
surgeries = hospital_resource(:,4);

%% 4. Combine Data
data = [nurses icuBeds fluCases surgeries];

%% 5. Train-Test Split (80/20)
cv = cvpartition(size(data,1),'HoldOut',0.2);

trainData = data(training(cv),:);
testData  = data(test(cv),:);

%% 6. Train Prediction Models (Random Forest)

% Predict Nurses
model_nurse = fitrensemble(trainData(:,2:4), trainData(:,1), ...
    'Method','Bag','NumLearningCycles',100);

% Predict ICU Beds
model_icu = fitrensemble(trainData(:,[1 3 4]), trainData(:,2), ...
    'Method','Bag','NumLearningCycles',100);

% Predict Flu Cases
model_flu = fitrensemble(trainData(:,[1 2 4]), trainData(:,3), ...
    'Method','Bag','NumLearningCycles',100);

% Predict Surgeries
model_surg = fitrensemble(trainData(:,1:3), trainData(:,4), ...
    'Method','Bag','NumLearningCycles',100);

disp('Model training completed.');

%% 7. Predictions

pred_nurse = predict(model_nurse, testData(:,2:4));
pred_icu   = predict(model_icu, testData(:,[1 3 4]));
pred_flu   = predict(model_flu, testData(:,[1 2 4]));
pred_surg  = predict(model_surg, testData(:,1:3));

%% 8. Performance Evaluation

MAE_nurse = mean(abs(testData(:,1) - pred_nurse));
MAE_icu   = mean(abs(testData(:,2) - pred_icu));
MAE_flu   = mean(abs(testData(:,3) - pred_flu));
MAE_surg  = mean(abs(testData(:,4) - pred_surg));

fprintf('\nMean Absolute Error (MAE)\n');
fprintf('Nurses    : %.2f\n', MAE_nurse);
fprintf('ICU Beds  : %.2f\n', MAE_icu);
fprintf('Flu Cases : %.2f\n', MAE_flu);
fprintf('Surgeries : %.2f\n', MAE_surg);

%% 9. Visualization (Actual vs Predicted)

figure;
hold on;

% Nurses
plot(testData(:,1),'r','LineWidth',2)
plot(pred_nurse,'r--','LineWidth',2)

% ICU Beds
plot(testData(:,2),'b','LineWidth',2)
plot(pred_icu,'b--','LineWidth',2)

% Flu Cases
plot(testData(:,3),'g','LineWidth',2)
plot(pred_flu,'g--','LineWidth',2)

% Surgeries
plot(testData(:,4),'m','LineWidth',2)
plot(pred_surg,'m--','LineWidth',2)

xlabel('Sample Index')
ylabel('Hospital Resource Count')

title('Actual vs Predicted Hospital Resource Allocation')

legend('Nurses (Actual)','Nurses (Predicted)', ...
       'ICU Beds (Actual)','ICU Beds (Predicted)', ...
       'Flu Cases (Actual)','Flu Cases (Predicted)', ...
       'Surgeries (Actual)','Surgeries (Predicted)')

grid on
hold off

%% 10. Save Trained Models

save('Hospital_Resource_Prediction_Models.mat', ...
     'model_nurse','model_icu','model_flu','model_surg');

disp('Models saved successfully.');
